# Keep real credentials in .env. Do not commit .env.
DATABASE_URL=postgresql://user:password@host:5432/database

# Encrypt the demo connection without verifying the server certificate.
# No CA file is needed. Keep TLS options out of DATABASE_URL when using this.
PGSSLMODE=require
# For a local disposable database without TLS only: PGSSLMODE=disable

# Optional port for the loopback-only showcase API and static server.
# PORT=8787
